# Documentation only: server.py does not automatically load this file.
# Export variables in your shell or use /etc/loxicom/keypad.env on an installed Pi.
KEYPAD_PORT=8765
# KEYPAD_STATE_DIR=/absolute/path/to/private/astra-state
# UNIFI_CA_FILE=/absolute/path/to/trusted-console-ca.pem
# Or configure an independently verified console certificate fingerprint:
# UNIFI_CERT_SHA256=REPLACE_WITH_VERIFIED_64_HEX_CHARACTER_FINGERPRINT

# Optional computer setup. Provision your own trusted certificate and hostname.
# KEYPAD_WEB_ORIGIN=https://panel.example.com:8767
# KEYPAD_WEB_BIND=192.168.1.50
# KEYPAD_WEB_CERT=/absolute/path/to/fullchain.pem
# KEYPAD_WEB_TLS_KEY=/absolute/path/to/private-key.pem
# KEYPAD_WEB_LANDING_PORT=8080
